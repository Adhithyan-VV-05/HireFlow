# ==============================================================================
# HireFlow AI - Environment Variables Reference (.env.example)
# Copy this file to .env and provide your actual API keys and secrets.
# ==============================================================================

# AI Service Providers
# Get a Google Gemini API Key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
# Default is local SQLite. For PostgreSQL: postgresql://user:password@localhost:5432/hireflow
DATABASE_URL=sqlite:///hireflow.db

# Security & Authentication
# Generate a secure 32+ character random secret for production JWT signing
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ATS Integration (mock | greenhouse)
ATS_PROVIDER=mock
GREENHOUSE_API_KEY=
GREENHOUSE_API_URL=https://harvest.greenhouse.io/v1

# Server Configuration
PORT=8000
HOST=0.0.0.0
